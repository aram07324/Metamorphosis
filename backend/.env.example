APP_ENV=development
APP_NAME=Metamorphosis API
DATABASE_URL=sqlite:///./data/metamorphosis.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_TIMEOUT_SECONDS=90
CHAT_CONTEXT_TOKENS=4096
CHAT_RESERVED_OUTPUT_TOKENS=512
CHAT_SYSTEM_PROMPT=You are Metamorphosis, a helpful AI assistant. Be clear, accurate, and concise.
